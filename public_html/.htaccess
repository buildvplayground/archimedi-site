# ArchiMedi — Apache (Hostinger public_html)
Options -Indexes
DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(webp|svg|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Arquivo de controle do deploy (GitHub Actions/FTP): não servir na web
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Endereço único (www → sem www) e URLs do site antigo no Google (/arquitetura/saude) → home
<IfModule mod_rewrite.c>
  RewriteEngine On
  # www → sem www (mesmo endereço do canonical e do sitemap)
  RewriteCond %{HTTP_HOST} ^www\.archimedi\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://archimedi.com.br/$1 [R=301,L]
  RewriteRule ^arquitetura(/.*)?$ / [R=301,L]
</IfModule>

# HTTPS já é forçado pela Hostinger (http → https 301)
# Força HTTPS (ative após o domínio ter SSL)
